# Copy to .env (chmod 600) and fill in. Never commit .env. See docs/DEPLOYMENT.md.
# Generate random values with:  python3 -c "import secrets; print(secrets.token_urlsafe(36))"

# development | test | production. Production refuses to start without MI_API_TOKEN (32+ characters),
# with a default database password, or with demo data.
MI_APP_ENV=development
MI_LOG_LEVEL=INFO
MI_TIMEZONE=Asia/Kolkata

# Database (local development uses the system PostgreSQL; Docker uses the db service and builds the URL itself)
MI_DB_NAME=momentum
MI_DB_USER=momentum
MI_DB_PASSWORD=change-me
MI_DATABASE_URL=postgresql+psycopg://momentum:change-me@localhost:5432/momentum

# Data: demo = clearly labelled synthetic data; live = real providers below (required in production)
MI_DATA_MODE=demo
MI_DAILY_PROVIDER=nse_archive
MI_INTRADAY_PROVIDER=yahoo

# Dashboard/API access token (enter it once on the dashboard's Settings page). Required in production.
MI_API_TOKEN=

# Docker: host port for the API on 127.0.0.1, and the public domain for the optional HTTPS proxy
MI_PORT=8000
MI_DOMAIN=

# Backups (scripts/backup.sh)
MI_BACKUP_DIR=./backups
MI_BACKUP_KEEP=14

# Not used yet (no Kite connection is configured)
MI_KITE_API_KEY=
MI_KITE_API_SECRET=

# Optional Claude commentary on the daily report (off by default)
MI_ANTHROPIC_API_KEY=
MI_AI_ENABLED=false
MI_AI_MODEL=claude-opus-5-5
