# Copy to .env and fill in. Never commit .env.
MI_APP_ENV=development
MI_LOG_LEVEL=INFO
MI_TIMEZONE=Asia/Kolkata

# Database (local development uses the system PostgreSQL; Docker uses the db service)
MI_DB_NAME=momentum
MI_DB_USER=momentum
MI_DB_PASSWORD=change-me
MI_DATABASE_URL=postgresql+psycopg://momentum:change-me@localhost:5432/momentum

# Data: demo = clearly labelled synthetic data; live = real providers below
MI_DATA_MODE=demo
MI_DAILY_PROVIDER=nse_archive
MI_INTRADAY_PROVIDER=yahoo

# Secrets (leave empty until needed)
MI_API_TOKEN=
MI_KITE_API_KEY=
MI_KITE_API_SECRET=
MI_ANTHROPIC_API_KEY=
MI_AI_ENABLED=false
MI_AI_MODEL=claude-opus-5-5
